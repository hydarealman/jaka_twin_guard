# Colcon 编译产物
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Local-only model/video evaluation artifacts (never part of the enterprise
# release; keep only aggregate metrics and license references in docs).
artifacts/
/yolov8n.pt
.codex_runtime/
.runtime/

# Local CAD deliveries and conversion scratch data.  Git keeps the reviewed
# production STL meshes and conversion tools; raw STEP/SolidWorks archives
# stay outside the source repository (some individual deliveries exceed the
# GitHub 100 MB object limit).
/tmp/
/src/*.zip
/src/*.STEP
/src/*.step
/src/*.stp
/src/fruit_picking_arm/*.zip
/src/fruit_picking_arm/*.STEP
/src/fruit_picking_arm/*.step
/src/fruit_picking_arm/*.stp

# Local eye-to-hand calibration evidence and automatic backups.  Keep the
# reviewed hand_eye_params.yaml result under version control, but do not upload
# raw camera frames or machine-specific absolute paths from calibration runs.
/src/fruit_picking_arm/config/hand_eye_captures/
/src/fruit_picking_arm/config/hand_eye_params.yaml.bak
/src/fruit_picking_arm/config/hand_eye_params.yaml.samples.yaml

# IDE
.vscode/
.idea/

# Docker (本地覆盖文件, 不提交)
docker/docker-compose.override.yml
docker/.env.local
*.log

# OS
.DS_Store
Thumbs.db
