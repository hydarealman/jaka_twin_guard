# ============================================================
# 方案A: WSL2 原生 Docker 环境变量
# 这些变量会被 docker-compose-wsl2.yml 使用
# ============================================================

# WSL2 网关 IP 即 Windows 宿主机 IP (VcXsrv 的地址)
# start.sh 会自动设置, 此处为默认值
DISPLAY=172.0.0.1:0.0

# 软件渲染 (0=关闭即GPU, 1=开启即软件)
LIBGL=1

# ROS2 DDS 域 ID (避免多用户冲突)
ROS_DOMAIN_ID=42

# Windows 项目根目录 (WSL2 内的路径)
PROJECT_ROOT=/mnt/d/jaka_twin_guard

# Docker 数据目录 (编译产物, 放在 WSL2 ext4 上加速)
DOCKER_DATA=${HOME}/.jaka_docker
