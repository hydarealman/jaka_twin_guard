<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="massage_world">
    <gravity>0 0 -9.81</gravity>

    <gui fullscreen="1">
      <camera name="user_camera">
        <pose>0.70 -1.50 1.20 0 0.75 4.80</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 地面 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>4 4</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>4 4</size></plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.42 0.42 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 光照 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 按摩床 (center x=0.70, y=0) — 两个 Box: 床框 + 床垫 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <model name="massage_bed">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="bed_frame">
        <collision name="frame_collision">
          <pose>0.70 0 0.04 0 0 0</pose>
          <geometry><box><size>1.20 0.66 0.08</size></box></geometry>
        </collision>
        <visual name="frame_visual">
          <pose>0.70 0 0.04 0 0 0</pose>
          <geometry><box><size>1.20 0.66 0.08</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.40 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="mattress">
        <pose>0.70 0 0.11 0 0 0</pose>
        <collision name="mattress_collision">
          <geometry><box><size>1.12 0.56 0.06</size></box></geometry>
        </collision>
        <visual name="mattress_visual">
          <geometry><box><size>1.12 0.56 0.06</size></box></geometry>
          <material>
            <ambient>0.50 0.55 0.70 1</ambient>
            <diffuse>0.50 0.55 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 人体模型 — Catmull-Rom 样条平滑背部曲面 (33根Y轴圆柱)    -->
    <!-- 间距2cm, 半径=thick*0.55 — 相邻圆柱重叠形成连续曲面       -->
    <!-- 所有四肢 z ≥ 0.18 (床垫顶0.14 + 4cm安全间距)              -->
    <!-- Z→Y: 绕X旋转90° → roll=1.5708 rad                        -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <model name="human_body">
      <static>true</static>

