<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="scene_b_bin_pick">
    <gravity>0 0 -9.81</gravity>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.45 -1.25 0.85 0 0.48 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.42 0.42 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 光照 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 工作台 (x=0.90, top=0.30) -->
    <model name="work_table">
      <static>true</static>
      <pose>0.90 0 0 0 0 0</pose>
      <link name="table_link">
        <collision name="table_top_collision">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><box><size>0.75 0.70 0.04</size></box></geometry>
        </collision>
        <visual name="table_top_visual">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><box><size>0.75 0.70 0.04</size></box></geometry>
          <material>
            <ambient>0.55 0.44 0.32 1</ambient>
            <diffuse>0.55 0.44 0.32 1</diffuse>
          </material>
        </visual>
        <collision name="fl_leg_collision"><pose>-0.335 -0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="fl_leg_visual"><pose>-0.335 -0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry>
          <material><ambient>0.35 0.28 0.20 1</ambient><diffuse>0.35 0.28 0.20 1</diffuse></material></visual>
        <collision name="fr_leg_collision"><pose>-0.335 0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="fr_leg_visual"><pose>-0.335 0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry>
          <material><ambient>0.35 0.28 0.20 1</ambient><diffuse>0.35 0.28 0.20 1</diffuse></material></visual>
        <collision name="bl_leg_collision"><pose>0.335 -0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="bl_leg_visual"><pose>0.335 -0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry>
          <material><ambient>0.35 0.28 0.20 1</ambient><diffuse>0.35 0.28 0.20 1</diffuse></material></visual>
        <collision name="br_leg_collision"><pose>0.335 0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="br_leg_visual"><pose>0.335 0.31 0.13 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.26</size></box></geometry>
          <material><ambient>0.35 0.28 0.20 1</ambient><diffuse>0.35 0.28 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 料框 (x=0.55, y=0.45, top=0.45) — 中空5壁结构 -->
    <model name="bin">
      <static>true</static>
      <pose>0.55 0.45 0.30 0 0 0</pose>
      <link name="bin_link">
        <!-- 底板 -->
        <collision name="bin_bottom"><pose>0 0 -0.0725 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.005</size></box></geometry></collision>
        <visual name="bin_bottom_vis"><pose>0 0 -0.0725 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.005</size></box></geometry>
          <material><ambient>0.35 0.35 0.42 1</ambient><diffuse>0.35 0.35 0.42 1</diffuse></material></visual>
        <!-- 前壁 +Y -->
        <collision name="bin_front"><pose>0 0.0975 0 0 0 0</pose>
          <geometry><box><size>0.20 0.005 0.15</size></box></geometry></collision>
        <visual name="bin_front_vis"><pose>0 0.0975 0 0 0 0</pose>
          <geometry><box><size>0.20 0.005 0.15</size></box></geometry>
          <material><ambient>0.35 0.35 0.42 1</ambient><diffuse>0.35 0.35 0.42 1</diffuse></material></visual>
        <!-- 后壁 -Y -->
        <collision name="bin_back"><pose>0 -0.0975 0 0 0 0</pose>
          <geometry><box><size>0.20 0.005 0.15</size></box></geometry></collision>
        <visual name="bin_back_vis"><pose>0 -0.0975 0 0 0 0</pose>
          <geometry><box><size>0.20 0.005 0.15</size></box></geometry>
          <material><ambient>0.35 0.35 0.42 1</ambient><diffuse>0.35 0.35 0.42 1</diffuse></material></visual>
        <!-- 左壁 +X -->
        <collision name="bin_left"><pose>0.0975 0 0 0 0 0</pose>
          <geometry><box><size>0.005 0.20 0.15</size></box></geometry></collision>
        <visual name="bin_left_vis"><pose>0.0975 0 0 0 0 0</pose>
          <geometry><box><size>0.005 0.20 0.15</size></box></geometry>
          <material><ambient>0.35 0.35 0.42 1</ambient><diffuse>0.35 0.35 0.42 1</diffuse></material></visual>
        <!-- 右壁 -X -->
        <collision name="bin_right"><pose>-0.0975 0 0 0 0 0</pose>
          <geometry><box><size>0.005 0.20 0.15</size></box></geometry></collision>
        <visual name="bin_right_vis"><pose>-0.0975 0 0 0 0 0</pose>
          <geometry><box><size>0.005 0.20 0.15</size></box></geometry>
          <material><ambient>0.35 0.35 0.42 1</ambient><diffuse>0.35 0.35 0.42 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 货物在料框内 (x=0.55, y=0.45, z=0.25) -->
    <model name="cargo_box">
      <pose>0.55 0.45 0.25 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.0111</ixx><iyy>0.0039</iyy><izz>0.0126</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.18 0.345 0.12</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.345 0.12</size></box></geometry>
          <material>
            <ambient>0.85 0.36 0.12 1</ambient>
            <diffuse>0.85 0.36 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>
  </world>
</sdf>
