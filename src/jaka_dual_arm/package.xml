<?xml version="1.0"?>
<package format="3">
  <name>jaka_dual_arm</name>
  <version>0.1.0</version>
  <description>
    Industrial-grade dual-arm manipulation framework for JAKA C5.
    Architecture inspired by ManyMove — layered design with
    PlannerServer / Skills / SceneManager / BehaviorTree orchestration.
  </description>
  <author email="hydarealman@gmail.com">hydarealman</author>
  <maintainer email="hydarealman@gmail.com">hydarealman</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>xacro</depend>

  <exec_depend>dual_arm_jaka_c5_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
