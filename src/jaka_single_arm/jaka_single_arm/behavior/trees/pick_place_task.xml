<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!--
    Pick-and-Place Task — single-arm JAKA C5
    Architecture: jaka_single_arm layered framework (v0.1.0)

    Task flow:
      WaitServices → SetupScene → DetectObjects →
      For each detected object:
        Approach → Grasp(close gripper) → Lift →
        Place(bin) → OpenGripper → Retreat
  -->
  <BehaviorTree ID="PickPlaceTask">
    <Sequence name="MainSequence">

      <!-- Phase 0: Initialization -->
      <WaitServices name="WaitForServices"/>
      <SetupScene name="SetupPlanningScene"/>

      <!-- Phase 1: Perception -->
      <RetryUntilSuccessful num_attempts="3">
        <DetectObjects name="DetectObjectsOnTable"/>
      </RetryUntilSuccessful>

      <!--
        Phase 2-5: Per-object pick-and-place
        The Fallback wraps the sequence so we can continue
        even if individual objects fail. Each Sequence processes
        one object (target_object set from detected_objects list).
      -->

      <!-- Object 1: Approach + Grasp + Lift + Place + Retreat -->
      <Sequence name="PickPlaceObject1">
        <PlanApproach name="PlanApproach_1"/>
        <ExecuteTrajectory name="ExecApproach_1"/>
        <PlanGrasp name="PlanGrasp_1"/>
        <ExecuteTrajectory name="ExecGrasp_1"/>
        <ControlGripper name="CloseGripper_1" action="close"/>
        <CheckGrasp name="CheckGrasp_1"/>
        <PlanLift name="PlanLift_1"/>
        <ExecuteTrajectory name="ExecLift_1"/>
        <PlanPlace name="PlanPlace_1"/>
        <ExecuteTrajectory name="ExecPlace_1"/>
        <ControlGripper name="OpenGripper_1" action="open"/>
        <PlanRetreat name="PlanRetreat_1"/>
        <ExecuteTrajectory name="ExecRetreat_1"/>
      </Sequence>

    </Sequence>
  </BehaviorTree>
</root>
