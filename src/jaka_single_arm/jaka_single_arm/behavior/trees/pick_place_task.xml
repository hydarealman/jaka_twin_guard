<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!--
    Pick-and-Place Task — single-arm JAKA C5
    Architecture: jaka_single_arm layered framework (v0.1.0)

    Two trees:
      SetupTree      — one-time initialization (services, scene, detection)
      PickPlaceTree  — per-object pick-and-place (called for each detected object)
  -->

  <!-- ── Setup Tree (runs once) ── -->
  <BehaviorTree ID="SetupTree">
    <Sequence name="SetupSequence">
      <!-- Phase 0: Initialization -->
      <WaitServices name="WaitForServices"/>
      <SetupScene name="SetupPlanningScene"/>

      <!-- Phase 1: Perception -->
      <RetryUntilSuccessful num_attempts="3">
        <DetectObjects name="DetectObjectsOnTable"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- ── Per-Object Pick-and-Place Tree ── -->
  <BehaviorTree ID="PickPlaceTree">
    <Sequence name="PickPlaceObject">
      <!-- Approach to hover above object -->
      <PlanApproach name="PlanApproach"/>
      <ExecuteTrajectory name="ExecApproach"/>

      <!-- Descend to grasp pose -->
      <PlanGrasp name="PlanGrasp"/>
      <ExecuteTrajectory name="ExecGrasp"/>

      <!-- Close gripper -->
      <ControlGripper name="CloseGripper" action="close"/>

      <!-- Verify grasp -->
      <CheckGrasp name="CheckGrasp"/>

      <!-- Lift object -->
      <PlanLift name="PlanLift"/>
      <ExecuteTrajectory name="ExecLift"/>

      <!-- Move to bin, descend, release, retract (multi-stage) -->
      <PlanPlace name="PlanPlace"/>

      <!-- Retreat to HOME -->
      <PlanRetreat name="PlanRetreat"/>
      <ExecuteTrajectory name="ExecRetreat"/>
    </Sequence>
  </BehaviorTree>

</root>
