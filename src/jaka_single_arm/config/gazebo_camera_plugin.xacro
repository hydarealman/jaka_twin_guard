<?xml version="1.0"?>
<!--
  Gazebo RGBD Camera Plugin — 用于眼在手(eye-in-hand)深度相机仿真。
  挂载在 camera_link 上，发布:
    /camera/depth/points  — PointCloud2
    /camera/depth/image   — depth Image (16UC1)
    /camera/color/image   — color Image (RGB8)

  通过 xacro include 集成到 URDF 中 (在 sim_gazebo.launch.py 中处理)。
  也可以在 URDF xacro 中条件包含: <xacro:if value="$(arg use_gazebo)">。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gazebo_rgbd_camera"
               params="camera_link:=camera_link
                       camera_name:=wrist_depth_camera
                       update_rate:=10
                       width:=640 height:=480
                       hfov:=1.047
                       near:=0.05 far:=10.0">

    <gazebo reference="${camera_link}">
      <sensor type="depth" name="${camera_name}">

        <!-- 更新频率 -->
        <update_rate>${update_rate}</update_rate>

        <!-- 深度相机参数 -->
        <camera name="${camera_name}_depth">
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
        </camera>

        <!-- RGB 相机参数 (同深度相机) -->
        <camera name="${camera_name}_color">
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
        </camera>

        <!-- 深度相机插件 -->
        <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>depth/image:=depth/image</remapping>
            <remapping>depth/camera_info:=depth/camera_info</remapping>
          </ros>
          <camera_name>${camera_name}</camera_name>
          <frame_name>${camera_link}</frame_name>
          <hack_baseline>0.07</hack_baseline>
        </plugin>

        <!-- PointCloud 输出插件 -->
        <plugin name="gazebo_ros_depth_camera_pcl" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>depth/points:=depth/points</remapping>
          </ros>
          <camera_name>${camera_name}</camera_name>
          <frame_name>${camera_link}</frame_name>
          <point_cloud_cutoff>0.4</point_cloud_cutoff>
          <point_cloud_cutoff_max>${far}</point_cloud_cutoff_max>
        </plugin>

      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
