<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pick_place">
    <gravity>0 0 -9.81</gravity>

    <physics name="fruit_sorting_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>80</iters><sor>1.3</sor></solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.65 -1.45 1.10 0 0.52 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>4 4</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>4 4</size></plane>
          </geometry>
          <material>
            <ambient>0.32 0.35 0.38 1</ambient>
            <diffuse>0.38 0.41 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 光照 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Soft fill light above the sorting cell for stable camera exposure. -->
    <light name="workcell_fill" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>0.65 -0.10 2.20 0 0 0</pose>
      <diffuse>0.75 0.78 0.82 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation>
        <range>5</range><constant>0.65</constant>
        <linear>0.08</linear><quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- Neutral backdrop makes the fruit silhouettes easier to inspect. -->
    <model name="sorting_cell_backdrop">
      <static>true</static>
      <pose>0.55 0.92 0.65 0 0 0</pose>
      <link name="backdrop_link">
        <collision name="backdrop_collision">
          <geometry><box><size>2.2 0.03 1.30</size></box></geometry>
        </collision>
        <visual name="backdrop_visual">
          <geometry><box><size>2.2 0.03 1.30</size></box></geometry>
          <material>
            <ambient>0.70 0.73 0.76 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Fixed eye-to-hand RGB-D camera.  This is a world model rather than a
      robot link, so it remains completely independent of arm motion/control.
      Pose is aimed at the centre of the picking table.  Topic names match the
      RealSense ROS 2 wrapper used on hardware.
    -->
    <model name="eye_to_hand_rgbd_camera">
      <static>true</static>

      <link name="stand_link">
        <pose>1.25 -0.80 0 0 0 0</pose>
        <collision name="stand_base_collision">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="stand_base_visual">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.16 0.18 0.20 1</diffuse></material>
        </visual>
        <collision name="stand_column_collision">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="stand_column_visual">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.28 0.31 0.34 1</ambient><diffuse>0.35 0.38 0.41 1</diffuse></material>
        </visual>
      </link>

      <link name="camera_link">
        <pose>1.25 -0.80 1.05 0 0.611 2.268</pose>
        <collision name="camera_body_collision">
          <geometry><box><size>0.09 0.03 0.03</size></box></geometry>
        </collision>
        <visual name="camera_body_visual">
          <geometry><box><size>0.09 0.03 0.03</size></box></geometry>
          <material><ambient>0.08 0.22 0.32 1</ambient><diffuse>0.10 0.30 0.44 1</diffuse></material>
        </visual>
        <visual name="camera_lens_visual">
          <pose>0.047 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.015 0.02 0.025 1</ambient><diffuse>0.02 0.03 0.04 1</diffuse></material>
        </visual>

        <sensor name="eye_to_hand_rgbd" type="depth">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>15.0</update_rate>
          <camera>
            <horizontal_fov>1.211</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <depth_camera />
            <clip><near>0.10</near><far>3.0</far></clip>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
          </camera>
          <plugin name="eye_to_hand_rgbd_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/camera</namespace>
              <remapping>camera/image_raw:=camera/color/image_raw</remapping>
              <remapping>camera/camera_info:=camera/color/camera_info</remapping>
              <remapping>camera/depth/image_raw:=camera/depth/image_rect_raw</remapping>
              <remapping>camera/depth/camera_info:=camera/depth/camera_info</remapping>
              <remapping>camera/points:=camera/depth/color/points</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>camera_color_optical_frame</frame_name>
            <min_depth>0.10</min_depth>
            <max_depth>3.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 工作台 (x=0.70, y=0.0, top_z=0.30) -->
    <model name="work_table">
      <static>true</static>
      <pose>0.70 0 0 0 0 0</pose>
      <link name="table_link">
        <collision name="table_top_collision">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><box><size>0.75 0.70 0.04</size></box></geometry>
        </collision>
        <visual name="table_top_visual">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><box><size>0.75 0.70 0.04</size></box></geometry>
          <material>
            <ambient>0.50 0.35 0.22 1</ambient>
            <diffuse>0.50 0.35 0.22 1</diffuse>
          </material>
        </visual>
        <!-- Four legs make the physical workcell easier to read in Gazebo. -->
        <collision name="leg_1_collision"><pose>0.335 0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="leg_1_visual"><pose>0.335 0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.22 0.24 0.26 1</diffuse></material></visual>
        <collision name="leg_2_collision"><pose>0.335 -0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="leg_2_visual"><pose>0.335 -0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.22 0.24 0.26 1</diffuse></material></visual>
        <collision name="leg_3_collision"><pose>-0.335 0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="leg_3_visual"><pose>-0.335 0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.22 0.24 0.26 1</diffuse></material></visual>
        <collision name="leg_4_collision"><pose>-0.335 -0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry></collision>
        <visual name="leg_4_visual"><pose>-0.335 -0.31 0.13 0 0 0</pose><geometry><box><size>0.04 0.04 0.26</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.22 0.24 0.26 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 料框 (x=0.55, y=0.45, top_z=0.30, 0.20x0.20x0.15) -->
    <model name="bin">
      <static>true</static>
      <pose>0.55 0.45 0.225 0 0 0</pose>
      <link name="bin_link">
        <!-- 底面 -->
        <collision name="bottom_collision">
          <pose>0 0 -0.065 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.02</size></box></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 -0.065 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.02</size></box></geometry>
          <material>
            <ambient>0.18 0.50 0.24 1</ambient>
            <diffuse>0.22 0.62 0.30 1</diffuse>
          </material>
        </visual>
        <!-- 四壁 -->
        <collision name="wall_ny_collision"><pose>0 0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry></collision>
        <visual name="wall_ny_visual"><pose>0 0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry><material><ambient>0.18 0.50 0.24 1</ambient><diffuse>0.22 0.62 0.30 1</diffuse></material></visual>
        <collision name="wall_py_collision"><pose>0 -0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry></collision>
        <visual name="wall_py_visual"><pose>0 -0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry><material><ambient>0.18 0.50 0.24 1</ambient><diffuse>0.22 0.62 0.30 1</diffuse></material></visual>
        <collision name="wall_nx_collision"><pose>0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry></collision>
        <visual name="wall_nx_visual"><pose>0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry><material><ambient>0.18 0.50 0.24 1</ambient><diffuse>0.22 0.62 0.30 1</diffuse></material></visual>
        <collision name="wall_px_collision"><pose>-0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry></collision>
        <visual name="wall_px_visual"><pose>-0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry><material><ambient>0.18 0.50 0.24 1</ambient><diffuse>0.22 0.62 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 坏果料框 unhealthy (x=0.55, y=-0.45, top_z=0.30, 0.20x0.20x0.15) -->
    <model name="bin_unhealthy">
      <static>true</static>
      <pose>0.55 -0.45 0.225 0 0 0</pose>
      <link name="bin_link">
        <collision name="bottom_collision"><pose>0 0 -0.065 0 0 0</pose><geometry><box><size>0.20 0.20 0.02</size></box></geometry></collision>
        <visual name="bottom_visual"><pose>0 0 -0.065 0 0 0</pose><geometry><box><size>0.20 0.20 0.02</size></box></geometry><material><ambient>0.55 0.30 0.20 1</ambient><diffuse>0.55 0.30 0.20 1</diffuse></material></visual>
        <collision name="wall_ny_collision"><pose>0 0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry></collision>
        <visual name="wall_ny_visual"><pose>0 0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry><material><ambient>0.55 0.30 0.20 1</ambient><diffuse>0.55 0.30 0.20 1</diffuse></material></visual>
        <collision name="wall_py_collision"><pose>0 -0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry></collision>
        <visual name="wall_py_visual"><pose>0 -0.095 0 0 0 0</pose><geometry><box><size>0.20 0.01 0.15</size></box></geometry><material><ambient>0.55 0.30 0.20 1</ambient><diffuse>0.55 0.30 0.20 1</diffuse></material></visual>
        <collision name="wall_nx_collision"><pose>0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry></collision>
        <visual name="wall_nx_visual"><pose>0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry><material><ambient>0.55 0.30 0.20 1</ambient><diffuse>0.55 0.30 0.20 1</diffuse></material></visual>
        <collision name="wall_px_collision"><pose>-0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry></collision>
        <visual name="wall_px_visual"><pose>-0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.20 0.15</size></box></geometry><material><ambient>0.55 0.30 0.20 1</ambient><diffuse>0.55 0.30 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══ 苹果 (贴真实苹果照片纹理，供 YOLO 识别 Healthy/Unhealthy) ═══ -->
    <!-- 苹果 1: Healthy (r=0.035, x=0.50, y=-0.20) -->
    <model name="fruit_apple_1">
      <static>false</static>
      <pose>0.50 -0.20 0.335 0 0 0</pose>
      <link name="apple_link">
        <inertial><mass>0.15</mass><inertia><ixx>7.35e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.35e-05</iyy><iyz>0</iyz><izz>7.35e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://materials/scripts</uri>
              <uri>file://materials/textures</uri>
              <name>Apple/Healthy</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 苹果 2: Unhealthy (r=0.040, x=0.55, y=-0.05) -->
    <model name="fruit_apple_2">
      <static>false</static>
      <pose>0.55 -0.05 0.340 0 0 0</pose>
      <link name="apple_link">
        <inertial><mass>0.18</mass><inertia><ixx>1.15e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.15e-04</iyy><iyz>0</iyz><izz>1.15e-04</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.040</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.040</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://materials/scripts</uri>
              <uri>file://materials/textures</uri>
              <name>Apple/Unhealthy</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 苹果 3: Healthy (r=0.030, x=0.40, y=0.15) -->
    <model name="fruit_apple_3">
      <static>false</static>
      <pose>0.40 0.15 0.330 0 0 0</pose>
      <link name="apple_link">
        <inertial><mass>0.10</mass><inertia><ixx>3.60e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.60e-05</iyy><iyz>0</iyz><izz>3.60e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.030</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.030</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://materials/scripts</uri>
              <uri>file://materials/textures</uri>
              <name>Apple/Healthy</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 苹果 4: Unhealthy (r=0.028, x=0.72, y=-0.20) -->
    <model name="fruit_apple_4">
      <static>false</static>
      <pose>0.72 -0.20 0.328 0 0 0</pose>
      <link name="apple_link">
        <inertial><mass>0.08</mass><inertia><ixx>2.51e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.51e-05</iyy><iyz>0</iyz><izz>2.51e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.028</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.028</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://materials/scripts</uri>
              <uri>file://materials/textures</uri>
              <name>Apple/Unhealthy</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gazebo ROS state plugin (必须: 使 ros2_control 能读取仿真状态) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
        <argument>--ros-args</argument>
      </ros>
    </plugin>

  </world>
</sdf>
