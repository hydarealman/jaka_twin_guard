class Dashboard(Node):
    ACTIONS = ("capture", "remove_last", "clear", "solve", "save", "status")

    def __init__(self):
        super().__init__("hand_eye_calibration_dashboard")
        self.declare_parameter("host", "127.0.0.1")
        self.declare_parameter("port", 8765)
        self.declare_parameter("config_file", "")
        self.declare_parameter("output_yaml", "")
        self._bridge = CvBridge()
        self._jpeg = b""
        self._frame_lock = threading.Lock()
        self._frame_width = 0
        self._frame_height = 0
        self._frame_times = deque(maxlen=60)
        self._service_clients = {
            action: self.create_client(Trigger, f"/hand_eye_calibration/{action}")
            for action in self.ACTIONS
        }
        self.create_subscription(
            Image,
            "/hand_eye_calibration/annotated",
            self._on_image,
            qos_profile_sensor_data,
        )
        host = str(self.get_parameter("host").value)
        port = int(self.get_parameter("port").value)
        handler = self._make_handler()
        self._server = ThreadingHTTPServer((host, port), handler)
        self._server.daemon_threads = True
        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
        self._thread.start()
        self.get_logger().info(f"Calibration dashboard: http://{host}:{port}")

    def _on_image(self, message: Image) -> None:
        try:
            image = self._bridge.imgmsg_to_cv2(message, desired_encoding="bgr8")
            ok, encoded = cv2.imencode(".jpg", image, [cv2.IMWRITE_JPEG_QUALITY, 86])
            if ok:
                with self._frame_lock:
                    self._jpeg = encoded.tobytes()
                    self._frame_height, self._frame_width = image.shape[:2]
                    self._frame_times.append(time.monotonic())
        except Exception as error:  # keep dashboard alive on a malformed frame
            self.get_logger().warning(f"Dashboard image conversion failed: {error}")

    def call_action(self, action: str, timeout: float = 8.0) -> dict:
        client = self._service_clients.get(action)
        if client is None:
            return {"success": False, "message": f"unknown action: {action}"}
        if not client.wait_for_service(timeout_sec=0.2):
            return {"success": False, "message": "标定服务尚未启动，请稍后重试"}
        future = client.call_async(Trigger.Request())
        done = threading.Event()
        future.add_done_callback(lambda _future: done.set())
        if not done.wait(timeout):
            return {"success": False, "message": f"{action} 操作超时"}
        try:
            response = future.result()
            return {"success": bool(response.success), "message": response.message}
        except Exception as error:
            return {"success": False, "message": str(error)}

    def info(self) -> dict:
        output = str(self.get_parameter("output_yaml").value)
        with self._frame_lock:
            width = self._frame_width
            height = self._frame_height
            times = list(self._frame_times)
        fps = 0.0
        if len(times) > 1 and times[-1] > times[0]:
            fps = (len(times) - 1) / (times[-1] - times[0])
        video = (
            f"{width}×{height}，{fps:.1f} FPS"
            if width and height else "等待视频帧"
        )
        return {
            "video": video,
            "config_file": str(self.get_parameter("config_file").value),
            "output_yaml": output,
            "capture_hint": f"{output}.samples.yaml 中记录具体 PNG 路径",
        }

    def latest_jpeg(self) -> bytes:
        with self._frame_lock:
            return self._jpeg

    def _make_handler(self):
        dashboard = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, _format, *_args):
                return

            def _send(self, status, content_type, body):
                self.send_response(status)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                path = urlparse(self.path).path
                if path == "/":
                    self._send(200, "text/html; charset=utf-8", PAGE.encode())
                elif path == "/stream.mjpg":
                    self.send_response(200)
                    self.send_header(
                        "Content-Type", "multipart/x-mixed-replace; boundary=frame"
                    )
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    last_image = None
                    try:
                        while True:
                            current = dashboard.latest_jpeg()
                            if current and current is not last_image:
                                self.wfile.write(b"--frame\r\n")
                                self.wfile.write(b"Content-Type: image/jpeg\r\n")
                                self.wfile.write(
                                    f"Content-Length: {len(current)}\r\n\r\n".encode()
                                )
                                self.wfile.write(current)
                                self.wfile.write(b"\r\n")
                                self.wfile.flush()
                                last_image = current
                            time.sleep(1.0 / 20.0)
                    except (BrokenPipeError, ConnectionResetError):
                        return
                elif path == "/frame.jpg":
                    image = dashboard.latest_jpeg()
                    if image:
                        self._send(200, "image/jpeg", image)
                    else:
                        self._send(503, "text/plain; charset=utf-8", "等待相机画面".encode())
                elif path == "/api/info":
                    self._send(200, "application/json", json.dumps(dashboard.info(), ensure_ascii=False).encode())
                else:
                    self._send(404, "text/plain", b"not found")

            def do_POST(self):
                path = urlparse(self.path).path
                prefix = "/api/action/"
                if not path.startswith(prefix):
                    self._send(404, "text/plain", b"not found")
                    return
                result = dashboard.call_action(path[len(prefix):])
                self._send(200, "application/json", json.dumps(result, ensure_ascii=False).encode())

        return Handler

    def destroy_node(self):
        self._server.shutdown()
        self._server.server_close()
        return super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = Dashboard()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
