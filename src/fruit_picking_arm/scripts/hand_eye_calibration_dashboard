async function pollStatus(){try{const d=await (await fetch('/api/action/status',{method:'POST'})).json();badge.textContent=d.message;badge.className='badge '+(d.message.includes('detection=ready')?'ready':'')}catch(e){badge.textContent='连接断开';badge.className='badge'}}
