 try{const r=await fetch('/api/action/'+action,{method:'POST'});const d=await r.json();msg.textContent=d.message||JSON.stringify(d);msg.className=d.success?'ok':'bad';if(action==='status'){badge.textContent=d.message;badge.className='badge '+(d.message.includes('detection=ready')?'ready':'');}}
