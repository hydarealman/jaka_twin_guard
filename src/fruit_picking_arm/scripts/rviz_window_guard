#!/usr/bin/env python3
"""Repair RViz geometry that WSLg occasionally restores as a tiny window."""

from __future__ import annotations

import ctypes
import os
import time


def main() -> int:
    if not os.environ.get("DISPLAY"):
        print("[rviz-window] DISPLAY is unset; geometry guard skipped", flush=True)
        return 0

    x11 = ctypes.cdll.LoadLibrary("libX11.so.6")
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XQueryTree.argtypes = [
        ctypes.c_void_p,
        ctypes.c_ulong,
        ctypes.POINTER(ctypes.c_ulong),
        ctypes.POINTER(ctypes.c_ulong),
        ctypes.POINTER(ctypes.POINTER(ctypes.c_ulong)),
        ctypes.POINTER(ctypes.c_uint),
    ]
    x11.XFetchName.argtypes = [
        ctypes.c_void_p,
        ctypes.c_ulong,
        ctypes.POINTER(ctypes.c_char_p),
    ]
    x11.XFree.argtypes = [ctypes.c_void_p]
    x11.XMoveResizeWindow.argtypes = [
        ctypes.c_void_p,
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_uint,
        ctypes.c_uint,
    ]
    x11.XMapRaised.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XFlush.argtypes = [ctypes.c_void_p]
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]

    display = x11.XOpenDisplay(None)
    if not display:
        print("[rviz-window] cannot open X display; geometry guard skipped", flush=True)
        return 0

    def children(window: int) -> list[int]:
        root = ctypes.c_ulong()
        parent = ctypes.c_ulong()
        result = ctypes.POINTER(ctypes.c_ulong)()
        count = ctypes.c_uint()
        if not x11.XQueryTree(
            display,
            window,
            ctypes.byref(root),
            ctypes.byref(parent),
            ctypes.byref(result),
            ctypes.byref(count),
        ):
            return []
        values = [int(result[index]) for index in range(count.value)]
        if result:
            x11.XFree(result)
        return values

    def title(window: int) -> str:
        value = ctypes.c_char_p()
        if not x11.XFetchName(display, window, ctypes.byref(value)) or not value.value:
            return ""
        text = value.value.decode("utf-8", errors="replace")
        x11.XFree(value)
        return text

    try:
        deadline = time.monotonic() + 20.0
        root = int(x11.XDefaultRootWindow(display))
        while time.monotonic() < deadline:
            pending = children(root)
            seen: set[int] = set()
            while pending:
                window = pending.pop()
                if window in seen:
                    continue
                seen.add(window)
                name = title(window)
                # WSLg appends the distribution name, for example
                # "fruit_picking_arm.rviz* - RViz (Ubuntu-22.04)".
                if " - RViz" in name:
                    x11.XMoveResizeWindow(display, window, 40, 40, 1200, 760)
                    x11.XMapRaised(display, window)
                    x11.XFlush(display)
                    print(
                        "[rviz-window] RViz resized to 1200x760 for WSLg",
                        flush=True,
                    )
                    return 0
                pending.extend(children(window))
            time.sleep(0.25)
        print("[rviz-window] RViz window was not found within 20s", flush=True)
        return 0
    finally:
        x11.XCloseDisplay(display)


if __name__ == "__main__":
    raise SystemExit(main())
