<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!--
    Pick-and-Place Task — CAD-derived fruit-picking arm
    Architecture: fruit_picking_arm layered framework (v0.1.0)

    Two trees:
      SetupTree      — one-time initialization (services, scene, detection)
      PickPlaceTree  — per-object pick-and-place (called for each detected object)
  -->

  <!-- ── Setup Tree (runs once) ── -->
  <BehaviorTree ID="SetupTree">
    <Sequence name="SetupSequence">
      <!-- Register the visible collision scene before waiting for live robot
           feedback. This lets RViz show the table, bins and perceived fruit
           while motion remains blocked by WaitServices. -->
      <SetupScene name="SetupPlanningScene"/>

      <!-- Perception and collision registration do not command the robot. -->
      <RetryUntilSuccessful num_attempts="3">
        <DetectObjects name="DetectObjectsOnTable"/>
      </RetryUntilSuccessful>

      <!-- Final motion prerequisite: MoveIt/controller endpoints and a
           complete real joint state must exist before any plan can start. -->
      <WaitServices name="WaitForServices"/>
    </Sequence>
  </BehaviorTree>

  <!-- ── Per-Object Pick-and-Place Tree ── -->
  <BehaviorTree ID="PickPlaceTree">
    <Sequence name="PickPlaceObject">
      <!-- Approach to hover above object -->
      <PlanApproach name="PlanApproach"/>
      <ExecuteTrajectory name="ExecApproach"/>

      <!-- Descend to grasp pose -->
      <PlanGrasp name="PlanGrasp"/>
      <ExecuteTrajectory name="ExecGrasp"/>

      <!-- Close gripper -->
      <ControlGripper name="CloseGripper" action="close"/>

      <!-- The binary real gripper has no contact sensor. A successful close
           means the C board returned COMPLETED_UNVERIFIED; continue with the
           configured open-loop grasp policy. -->
      <PlanLift name="PlanLift"/>
      <ExecuteTrajectory name="ExecLift"/>

      <!-- Every place phase is separate so the real test mode can preview and
           approve the exact trajectory before it is sent to the C board. -->
      <PlanPlace name="PlanPlace"/>
      <ExecuteTrajectory name="ExecPlaceHover"/>
      <PlanPlaceDrop name="PlanPlaceDrop"/>
      <ExecuteTrajectory name="ExecPlaceDrop"/>
      <ControlGripper name="OpenGripper" action="open"/>
      <PlanPlaceRetract name="PlanPlaceRetract"/>
      <ExecuteTrajectory name="ExecPlaceRetract"/>

      <!-- Retreat to HOME -->
      <PlanRetreat name="PlanRetreat"/>
      <ExecuteTrajectory name="ExecRetreat"/>
    </Sequence>
  </BehaviorTree>

</root>
