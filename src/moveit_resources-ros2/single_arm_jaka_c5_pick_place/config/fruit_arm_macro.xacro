<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Kinematic model inferred from the supplied STEP assembly.  The drawing
    pose is URDF zero; mechanical reference lines therefore require the
    documented joint-coordinate offsets below. Visual meshes are millimetres
    and therefore use a 0.001 mesh scale. Collisions are deliberately simple.
  -->
  <xacro:macro name="fruit_arm" params="parent hardware_plugin initial_positions_file">
    <xacro:include filename="$(find single_arm_jaka_c5_pick_place)/config/jaka_c5.ros2_control.xacro" />
    <xacro:jaka_c5_arm_ros2_control
        hardware_plugin="${hardware_plugin}"
        initial_positions_file="${initial_positions_file}"/>

    <xacro:macro name="cad_visual" params="link color:='0.70 0.72 0.76 1'">
      <visual>
        <geometry>
          <mesh filename="package://fruit_arm_description/meshes/visual/${link}.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${link}_cad_material">
          <color rgba="${color}"/>
        </material>
      </visual>
    </xacro:macro>

    <xacro:macro name="simple_inertial" params="mass:='1.0'">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </xacro:macro>

    <joint name="base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="Link_00"/>
      <!-- CAD assembly front is -X; expose mechanical front as world +X. -->
      <origin xyz="0 0 0" rpy="0 0 3.141592654"/>
    </joint>

    <link name="Link_00">
      <xacro:simple_inertial mass="10.0"/>
      <xacro:cad_visual link="Link_00" color="0.25 0.29 0.34 1"/>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.17" length="0.04"/></geometry>
      </collision>
    </link>

    <link name="Link_01">
      <xacro:simple_inertial mass="8.0"/>
      <xacro:cad_visual link="Link_01" color="0.20 0.24 0.30 1"/>
      <collision>
        <origin xyz="-0.024 0.028 0.047" rpy="0 0 0"/>
        <geometry><box size="0.16 0.18 0.15"/></geometry>
      </collision>
    </link>
    <joint name="joint_1" type="revolute">
      <origin xyz="0 0 0.040975" rpy="0 0 0"/>
      <parent link="Link_00"/>
      <child link="Link_01"/>
      <axis xyz="0 0 1"/>
      <!-- Mechanical hard stop: +/-165 deg. -->
      <limit lower="-2.879793266" upper="2.879793266" effort="250" velocity="1.5"/>
    </joint>

    <link name="Link_02">
      <xacro:simple_inertial mass="8.0"/>
      <xacro:cad_visual link="Link_02" color="0.78 0.80 0.84 1"/>
      <collision>
        <origin xyz="0.200 -0.008 0.092" rpy="0 -0.43 -0.04"/>
        <geometry><box size="0.46 0.11 0.12"/></geometry>
      </collision>
    </link>
    <joint name="joint_2" type="revolute">
      <!-- Re-zero CAD assembly angle -65.196838 deg to mechanical J2=0. -->
      <origin xyz="-0.048101 0.056781 0.094025" rpy="0 -1.137899491 0"/>
      <parent link="Link_01"/>
      <child link="Link_02"/>
      <axis xyz="0 1 0"/>
      <!--
        Positive is clockwise when viewed along +Y. Mechanical hard stops:
        CCW 60 / CW 80 deg.
      -->
      <limit lower="-1.047197551" upper="1.396263402" effort="250" velocity="1.5"/>
    </joint>

    <link name="Link_03">
      <xacro:simple_inertial mass="5.0"/>
      <xacro:cad_visual link="Link_03" color="0.22 0.26 0.31 1"/>
      <collision>
        <origin xyz="-0.021 -0.016 0.029" rpy="0 0 0"/>
        <geometry><box size="0.13 0.13 0.15"/></geometry>
      </collision>
    </link>
    <joint name="joint_3" type="revolute">
      <!-- Re-zero CAD assembly angle +57.956279 deg to perpendicular J3=0. -->
      <origin xyz="0.399412 -0.015781 0.184581" rpy="0 1.011527890 0"/>
      <parent link="Link_02"/>
      <child link="Link_03"/>
      <axis xyz="0 1 0"/>
      <!--
        Mechanical hard stop: +/-90 deg from perpendicular upper/forearm.
      -->
      <limit lower="-1.570796327" upper="1.570796327" effort="180" velocity="1.5"/>
    </joint>

    <link name="Link_04">
      <xacro:simple_inertial mass="7.0"/>
      <xacro:cad_visual link="Link_04" color="0.76 0.78 0.82 1"/>
      <collision>
        <origin xyz="-0.186 -0.017 -0.003" rpy="0 0 0.092"/>
        <geometry><box size="0.40 0.12 0.13"/></geometry>
      </collision>
    </link>
    <joint name="joint_4" type="revolute">
      <!-- CAD logo-plane reference is opposite mechanical J4 zero. -->
      <origin xyz="-0.041455 -0.032800 0.057441" rpy="3.141592654 0 0"/>
      <parent link="Link_03"/>
      <child link="Link_04"/>
      <axis xyz="1 0 0"/>
      <!-- Mechanical hard stop: +/-170 deg. -->
      <limit lower="-2.967059728" upper="2.967059728" effort="120" velocity="1.8"/>
    </joint>

    <link name="Link_05">
      <xacro:simple_inertial mass="4.0"/>
      <xacro:cad_visual link="Link_05" color="0.22 0.26 0.31 1"/>
      <collision>
        <origin xyz="-0.013 0.027 -0.009" rpy="0 0 0"/>
        <geometry><box size="0.14 0.14 0.14"/></geometry>
      </collision>
    </link>
    <joint name="joint_5" type="revolute">
      <!-- Re-zero CAD assembly angle +33.439625 deg to mechanical J5=0. -->
      <origin xyz="-0.372174 -0.034450 -0.004890" rpy="0 0.583631552 0"/>
      <parent link="Link_04"/>
      <child link="Link_05"/>
      <axis xyz="0 1 0"/>
      <!--
        Mechanical hard stop: +/-90 deg from the J4-parallel reference.
      -->
      <limit lower="-1.570796327" upper="1.570796327" effort="100" velocity="1.8"/>
    </joint>

    <link name="Link_06">
      <xacro:simple_inertial mass="2.0"/>
      <xacro:cad_visual link="Link_06" color="0.35 0.38 0.43 1"/>
      <collision>
        <origin xyz="-0.030 0 -0.018" rpy="0 0 0"/>
        <geometry><box size="0.13 0.13 0.16"/></geometry>
      </collision>
    </link>
    <joint name="joint_6" type="revolute">
      <origin xyz="-0.026883 0.054950 -0.018957" rpy="0 0 0"/>
      <parent link="Link_05"/>
      <child link="Link_06"/>
      <axis xyz="-0.834467 0 -0.551058"/>
      <!-- Mechanical hard stop: +/-160 deg. -->
      <limit lower="-2.792526803" upper="2.792526803" effort="80" velocity="2.0"/>
    </joint>

    <link name="tool_flange"/>
    <joint name="tool_flange_joint" type="fixed">
      <origin xyz="-0.058148 0 -0.033366" rpy="0 1.57079632679 0"/>
      <parent link="Link_06"/>
      <child link="tool_flange"/>
    </joint>
  </xacro:macro>
</robot>
