<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="parallel_jaw_gripper" params="parent">

    <!-- Gripper base plate -->
    <link name="gripper_base">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.15" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.045 0.045 0.012" />
        </geometry>
        <material name="gripper_base_mat">
          <color rgba="0.35 0.35 0.40 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.045 0.045 0.012" />
        </geometry>
      </collision>
    </link>

    <joint name="gripper_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${parent}" />
      <child link="gripper_base" />
    </joint>

    <!-- Left finger -->
    <link name="left_finger">
      <inertial>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <mass value="0.08" />
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
      </inertial>
      <visual>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <geometry>
          <box size="0.008 0.012 0.08" />
        </geometry>
        <material name="left_finger_mat">
          <color rgba="0.55 0.55 0.60 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <geometry>
          <box size="0.008 0.012 0.08" />
        </geometry>
      </collision>
    </link>

    <joint name="left_finger_joint" type="prismatic">
      <origin xyz="0 0 -0.006" rpy="0 0 0" />
      <parent link="gripper_base" />
      <child link="left_finger" />
      <axis xyz="0 1 0" />
      <limit lower="0.0" upper="0.04" effort="50" velocity="0.2" />
    </joint>

    <!-- Left finger contact frame (tip center for grasp detection) -->
    <link name="left_finger_tip"/>
    <joint name="left_finger_tip_joint" type="fixed">
      <origin xyz="0 0 -0.08" rpy="0 0 0" />
      <parent link="left_finger" />
      <child link="left_finger_tip" />
    </joint>

    <!-- Right finger -->
    <link name="right_finger">
      <inertial>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <mass value="0.08" />
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
      </inertial>
      <visual>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <geometry>
          <box size="0.008 0.012 0.08" />
        </geometry>
        <material name="right_finger_mat">
          <color rgba="0.55 0.55 0.60 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <geometry>
          <box size="0.008 0.012 0.08" />
        </geometry>
      </collision>
    </link>

    <joint name="right_finger_joint" type="prismatic">
      <origin xyz="0 0 -0.006" rpy="0 0 0" />
      <parent link="gripper_base" />
      <child link="right_finger" />
      <axis xyz="0 1 0" />
      <limit lower="-0.04" upper="0.0" effort="50" velocity="0.2" />
    </joint>

    <!-- Right finger contact frame (tip center for grasp detection) -->
    <link name="right_finger_tip"/>
    <joint name="right_finger_tip_joint" type="fixed">
      <origin xyz="0 0 -0.08" rpy="0 0 0" />
      <parent link="right_finger" />
      <child link="right_finger_tip" />
    </joint>

  </xacro:macro>
</robot>
