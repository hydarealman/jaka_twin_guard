Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RobotModel1
        - /Scene Markers1
      Splitter Ratio: 0.5
    Tree Height: 420
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    # ── 网格 ── 辅助空间定位 ──
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 10
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    # ── 机械臂模型（基于 /robot_description + /joint_states → TF）──
    # 关键：/robot_description 由 robot_state_publisher 以 TRANSIENT_LOCAL 模式发布，
    # 必须显式指定相同的 Durability Policy，否则 RViz 收不到 latched 消息！
    - Alpha: 1.0
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true

    # TF axes remain useful when the serial board is absent: they make the
    # available real frame trees visible without inventing joint positions.
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.2
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true

    # ── 场景标记（桌子 / 料框 / 彩色水果小球，来自 /rviz_visual_tools）──
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Scene Markers
      Namespaces:
        {}
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz_visual_tools
      Value: true

    # ── 感知：检测到的物体（MarkerArray，/perception/detected_objects）──
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detected Objects
      Namespaces:
        detected_labels: true
        detected_objects: true
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/detected_objects
      Value: true

    # ── 感知：原始点云（ObjectDetector 实际发布话题）──
    # Mock 模式：直接由 MockCamera 发布（frame: world）
    # Gazebo 模式：GazeboCamera 从 /camera/depth/points 桥接转发（frame: camera_depth_frame）
    - Alpha: 0.5
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: Raw Point Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.003
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/debug/raw_cloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ── 实车 D455 原始点云（由真实深度图生成，相机坐标系）──
    # Use Fixed Frame=false so the raw camera cloud remains visible before
    # calibration, without pretending it is aligned with the robot/world.
    - Alpha: 0.4
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 200; 100
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: Real D455 Raw Depth (camera frame)
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.002
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/debug/camera_cloud
      Use Fixed Frame: false
      Use rainbow: true
      Value: true

    # ── 感知：RANSAC 实测桌面点云 ──
    # This is published only from the measured cloud. No scene_params table
    # geometry is injected into physical mode.
    - Alpha: 0.65
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 160; 110; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Measured Table Plane
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.003
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/debug/table_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ── 感知：桌面移除后点云（用于检查聚类分割质量）──
    - Alpha: 0.7
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 100; 200; 100
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Above-Table Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.005
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/debug/above_table_cloud
      Use Fixed Frame: true
      Value: true

    # ── MotionPlanning 插件已移除 ──
    # 原因：即使 Enabled: false，该插件仍会在后台异步初始化
    # planning_scene_monitor、MoveGroup、interactive_marker_display，
    # 其 PlanningScene 渲染加载后会与独立 RobotModel 冲突导致 RViz 冻结。
    # 如需查看碰撞物体/规划路径，可在 RViz 左侧面板手动 Add:
    #   By display type → moveit_rviz_plugin/MotionPlanning

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # Link_00 exists before hand-eye calibration. Using the nonexistent
    # "world" frame made the entire real bring-up view a blank grey canvas.
    Fixed Frame: Link_00
    Frame Rate: 5
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.5
        Y: 0.1
        Z: 0.4
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: -0.5
    Saved: {}
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Views:
    collapsed: true
  Width: 1400
  X: 50
  Y: 50
