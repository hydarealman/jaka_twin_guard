<?xml version="1.0" encoding="utf-8"?>
<robot name="jaka_c5_dual">
  <!-- GROUPS -->
  <group name="left_arm">
    <chain base_link="left_Link_00" tip_link="left_Link_06"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_Link_00" tip_link="right_Link_06"/>
  </group>

  <!-- GROUP STATES: Left arm starting pose - reaching slightly toward center -->
  <group_state group="left_arm" name="ready">
    <joint name="left_joint_1" value="0.5"/>
    <joint name="left_joint_2" value="1.0"/>
    <joint name="left_joint_3" value="-1.5"/>
    <joint name="left_joint_4" value="1.0"/>
    <joint name="left_joint_5" value="0.0"/>
    <joint name="left_joint_6" value="0.0"/>
  </group_state>

  <group_state group="left_arm" name="home">
    <joint name="left_joint_1" value="0.0"/>
    <joint name="left_joint_2" value="0.0"/>
    <joint name="left_joint_3" value="0.0"/>
    <joint name="left_joint_4" value="0.0"/>
    <joint name="left_joint_5" value="0.0"/>
    <joint name="left_joint_6" value="0.0"/>
  </group_state>

  <group_state group="right_arm" name="ready">
    <joint name="right_joint_1" value="-0.5"/>
    <joint name="right_joint_2" value="1.0"/>
    <joint name="right_joint_3" value="-1.5"/>
    <joint name="right_joint_4" value="1.0"/>
    <joint name="right_joint_5" value="0.0"/>
    <joint name="right_joint_6" value="0.0"/>
  </group_state>

  <group_state group="right_arm" name="home">
    <joint name="right_joint_1" value="0.0"/>
    <joint name="right_joint_2" value="0.0"/>
    <joint name="right_joint_3" value="0.0"/>
    <joint name="right_joint_4" value="0.0"/>
    <joint name="right_joint_5" value="0.0"/>
    <joint name="right_joint_6" value="0.0"/>
  </group_state>

  <!-- DISABLE COLLISIONS: Left arm self-collisions only -->
  <disable_collisions link1="left_Link_00" link2="left_Link_01" reason="Adjacent"/>
  <disable_collisions link1="left_Link_01" link2="left_Link_02" reason="Adjacent"/>
  <disable_collisions link1="left_Link_01" link2="left_Link_04" reason="Never"/>
  <disable_collisions link1="left_Link_02" link2="left_Link_03" reason="Adjacent"/>
  <disable_collisions link1="left_Link_03" link2="left_Link_04" reason="Adjacent"/>
  <disable_collisions link1="left_Link_04" link2="left_Link_05" reason="Adjacent"/>
  <disable_collisions link1="left_Link_04" link2="left_Link_06" reason="Never"/>
  <disable_collisions link1="left_Link_05" link2="left_Link_06" reason="Adjacent"/>

  <!-- DISABLE COLLISIONS: Right arm self-collisions only -->
  <disable_collisions link1="right_Link_00" link2="right_Link_01" reason="Adjacent"/>
  <disable_collisions link1="right_Link_01" link2="right_Link_02" reason="Adjacent"/>
  <disable_collisions link1="right_Link_01" link2="right_Link_04" reason="Never"/>
  <disable_collisions link1="right_Link_02" link2="right_Link_03" reason="Adjacent"/>
  <disable_collisions link1="right_Link_03" link2="right_Link_04" reason="Adjacent"/>
  <disable_collisions link1="right_Link_04" link2="right_Link_05" reason="Adjacent"/>
  <disable_collisions link1="right_Link_04" link2="right_Link_06" reason="Never"/>
  <disable_collisions link1="right_Link_05" link2="right_Link_06" reason="Adjacent"/>

  <!-- NOTE: No disable_collisions between left_* and right_* links -->
  <!-- Cross-arm collisions are ALWAYS checked by MoveIt for collision avoidance -->

</robot>
