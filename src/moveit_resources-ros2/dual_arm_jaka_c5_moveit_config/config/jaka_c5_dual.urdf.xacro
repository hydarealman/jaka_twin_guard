<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaka_c5_dual">

  <xacro:arg name="left_initial_positions_file"
          default="$(find dual_arm_jaka_c5_moveit_config)/config/left_initial_positions.yaml"/>
  <xacro:arg name="right_initial_positions_file"
          default="$(find dual_arm_jaka_c5_moveit_config)/config/right_initial_positions.yaml"/>

  <!-- Root link -->
  <link name="world"/>

  <!-- Xacro imports -->
  <xacro:include filename="jaka_c5_arm_macro.xacro" />

  <!-- Left arm: placed -0.25m along Y axis -->
  <xacro:jaka_c5_arm
      name="left_jaka_c5"
      prefix="left_"
      parent="world"
      initial_positions_file="$(arg left_initial_positions_file)">
      <origin xyz="0 -0.25 0" rpy="0 0 0" />
  </xacro:jaka_c5_arm>

  <!-- Right arm: placed +0.25m along Y axis -->
  <xacro:jaka_c5_arm
      name="right_jaka_c5"
      prefix="right_"
      parent="world"
      initial_positions_file="$(arg right_initial_positions_file)">
      <origin xyz="0 0.25 0" rpy="0 0 0" />
  </xacro:jaka_c5_arm>
</robot>
