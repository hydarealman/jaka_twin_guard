<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="jaka_c5_arm" params="name prefix parent *origin initial_positions_file">

    <!-- ros2_control -->
    <xacro:include filename="$(find dual_arm_jaka_c5_moveit_config)/config/jaka_c5.ros2_control.xacro" />
    <xacro:jaka_c5_arm_ros2_control name="${name}" initial_positions_file="${initial_positions_file}" prefix="${prefix}"/>

    <!-- base_joint fixes the arm base to the environment (world) -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}Link_00" />
    </joint>

    <!-- Link_00 (base) -->
    <link name="${prefix}Link_00">
      <!-- 惯性参数 -->
      <inertial>
        <!-- 重心位置 -->
        <origin xyz="0.0028167 -0.00019454 0.019544" rpy="0 0 0" />
        <!-- 质量(0.5公斤) -->
        <mass value="0.52663" />
        <!-- 转动惯量矩阵 -->
        <inertia ixx="0.0006297" ixy="6.7091E-08" ixz="3.4682E-06" iyy="0.00095727" iyz="2.4476E-07" izz="0.0014514" />
      </inertial>
      <!-- 可视化外观 -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_00.STL" />
        </geometry>
        <material name="">
          <color rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <!-- 碰撞模型 物理安全的"骨架" -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_00.STL" />
        </geometry>
      </collision>
    </link>

    <!-- Joint_1: Link_00 -> Link_01 -->
    <link name="${prefix}Link_01">
      <inertial>
        <origin xyz="-2.5186E-07 0.0033226 -0.001509" rpy="0 0 0" />
        <mass value="15.135" />
        <inertia ixx="0.044302" ixy="1.5349E-07" ixz="-6.1966E-07" iyy="0.043091" iyz="1.4326E-05" izz="0.030523" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_01.STL" />
        </geometry>
        <material name="">
          <color rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_01.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_1" type="revolute">
      <!-- 子坐标相对于父坐标的偏移 -->
      <origin xyz="0 -0.00022535 0.12015" rpy="0 0 0" />
      <!-- 定义父级 -->
      <parent link="${prefix}Link_00" />
      <!-- 定义子级 -->
      <child link="${prefix}Link_01" />
      <!-- 定义旋转轴 关节的运动方向 -->
      <axis xyz="0 0 1" />
       <!-- 软件限位 -->
      <limit lower="-6.28" upper="6.28" effort="2000" velocity="3.14" />
    </joint>

    <!-- Joint_2: Link_01 -> Link_02 -->
    <link name="${prefix}Link_02">
      <inertial>
        <origin xyz="0.215 6.4325E-09 -0.14315" rpy="0 0 0" />
        <mass value="45.847" />
        <inertia ixx="0.10377" ixy="-1.3562E-06" ixz="2.544E-07" iyy="1.5964" iyz="2.1509E-08" izz="1.5689" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_02.STL" />
        </geometry>
        <material name="">
          <color rgba="0.84706 0.84706 0.84706 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_02.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <parent link="${prefix}Link_01" />
      <child link="${prefix}Link_02" />
      <axis xyz="0 0 1" />
      <limit lower="-1.48" upper="4.62" effort="5000" velocity="3.14" />
    </joint>

    <!-- Joint_3: Link_02 -> Link_03 -->
    <link name="${prefix}Link_03">
      <inertial>
        <origin xyz="0.19073 -1.1854E-05 -0.010637" rpy="0 0 0" />
        <mass value="18.054" />
        <inertia ixx="0.022003" ixy="-3.4504E-06" ixz="-0.022449" iyy="0.41579" iyz="1.1408E-08" izz="0.41022" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_03.STL" />
        </geometry>
        <material name="">
          <color rgba="0.84706 0.84706 0.84706 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_03.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz="0.43 0 0" rpy="0 0 0" />
      <parent link="${prefix}Link_02" />
      <child link="${prefix}Link_03" />
      <axis xyz="0 0 1" />
      <limit lower="-3.05" upper="3.05" effort="5000" velocity="3.14" />
    </joint>

    <!-- Joint_4: Link_03 -> Link_04 -->
    <link name="${prefix}Link_04">
      <inertial>
        <origin xyz="-2.1463E-06 -0.0059512 0.0026789" rpy="0 0 0" />
        <mass value="5.5377" />
        <inertia ixx="0.0092004" ixy="1.17E-07" ixz="-1.3683E-08" iyy="0.0052083" iyz="-8.5741E-05" izz="0.0089125" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_04.STL" />
        </geometry>
        <material name="">
          <color rgba="0.84706 0.84706 0.84706 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_04.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz="0.3685 -1.185E-05 -0.114" rpy="0 0 0" />
      <parent link="${prefix}Link_03" />
      <child link="${prefix}Link_04" />
      <axis xyz="0 0 1" />
      <limit lower="-1.48" upper="4.62" effort="2000" velocity="3.14" />
    </joint>

    <!-- Joint_5: Link_04 -> Link_05 -->
    <link name="${prefix}Link_05">
      <inertial>
        <origin xyz="-2.0304E-06 -0.0028889 -0.0023424" rpy="0 0 0" />
        <mass value="6.3339" />
        <inertia ixx="0.012993" ixy="-1.0764E-07" ixz="5.8559E-09" iyy="0.0058454" iyz="4.5426E-05" izz="0.0127" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_05.STL" />
        </geometry>
        <material name="">
          <color rgba="0.84706 0.84706 0.84706 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_05.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz="0 -0.1135 0" rpy="1.5708 0 0" />
      <parent link="${prefix}Link_04" />
      <child link="${prefix}Link_05" />
      <axis xyz="0 0 1" />
      <limit lower="-6.28" upper="6.28" effort="3000" velocity="3.14" />
    </joint>

    <!-- Joint_6: Link_05 -> Link_06 (end effector mount) -->
    <link name="${prefix}Link_06">
      <inertial>
        <origin xyz="2.7652E-05 -1.3485E-05 -0.021245" rpy="0 0 0" />
        <mass value="1.4169" />
        <inertia ixx="0.00071853" ixy="-6.9778E-07" ixz="-6.378E-07" iyy="0.00072375" iyz="8.3072E-07" izz="0.0011337" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_06.STL" />
        </geometry>
        <material name="">
          <color rgba="0.84706 0.84706 0.84706 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://jaka_c5_description/meshes/jaka_c5_meshes/Link_06.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_6" type="revolute">
      <origin xyz="0 0.107 0" rpy="-1.5708 0 0" />
      <parent link="${prefix}Link_05" />
      <child link="${prefix}Link_06" />
      <axis xyz="0 0 1" />
      <limit lower="-6.28" upper="6.28" effort="1000" velocity="3.14" />
    </joint>

  </xacro:macro>
</robot>
