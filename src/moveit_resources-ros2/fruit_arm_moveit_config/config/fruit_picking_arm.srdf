<?xml version="1.0" encoding="utf-8"?>
<robot name="fruit_picking_arm">
  <!-- ===== PLANNING GROUPS ===== -->
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>

  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <group name="arm_with_gripper">
    <joint name="joint_1"/>
    <joint name="joint_2"/>
    <joint name="joint_3"/>
    <joint name="joint_4"/>
    <joint name="joint_5"/>
    <joint name="joint_6"/>
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <!-- ===== END EFFECTOR ===== -->
  <end_effector name="gripper_ee" parent_link="tool_flange" group="gripper" parent_group="arm"/>

  <!-- ===== GROUP STATES ===== -->

  <!-- Home/ready: collision-free forward/high parking pose. -->
  <group_state group="arm" name="home">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="1.265363708"/>
    <joint name="joint_3" value="-1.570796327"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <group_state group="arm" name="ready">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="1.265363708"/>
    <joint name="joint_3" value="-1.570796327"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Gripper states -->
  <group_state group="gripper" name="open">
    <joint name="left_finger_joint" value="0.056"/>
    <joint name="right_finger_joint" value="-0.056"/>
  </group_state>

  <group_state group="gripper" name="closed">
    <joint name="left_finger_joint" value="0.0"/>
    <joint name="right_finger_joint" value="0.0"/>
  </group_state>

  <!-- ===== SELF-COLLISION DISABLES ===== -->
  <!-- Adjacent link pairs (same as single-arm config) -->
  <disable_collisions link1="cad_base_link" link2="arm_link_1" reason="Adjacent"/>
  <disable_collisions link1="arm_link_1" link2="arm_link_2" reason="Adjacent"/>
  <disable_collisions link1="arm_link_1" link2="arm_link_4" reason="Never"/>
  <disable_collisions link1="arm_link_2" link2="arm_link_3" reason="Adjacent"/>
  <!-- The CAD arm folds arm_link_4 alongside arm_link_2.  Their deliberately
       conservative primitive boxes overlap although the CAD solids do not. -->
  <disable_collisions link1="arm_link_2" link2="arm_link_4" reason="CADPrimitiveFalsePositive"/>
  <disable_collisions link1="arm_link_3" link2="arm_link_4" reason="Adjacent"/>
  <disable_collisions link1="arm_link_4" link2="arm_link_5" reason="Adjacent"/>
  <disable_collisions link1="arm_link_4" link2="arm_link_6" reason="Never"/>
  <disable_collisions link1="arm_link_5" link2="arm_link_6" reason="Adjacent"/>

  <!-- Gripper self-collisions -->
  <disable_collisions link1="arm_link_6" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="tool_flange" link2="gripper_base" reason="Adjacent"/>
  <!-- All detailed gripper meshes are parts of one closed linkage. Pin, screw
       and finger contacts are intentional internal contacts; external object
       collision remains enabled on every physical gripper link. -->
  <disable_collisions link1="gripper_base" link2="gripper_center_slider" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_drive_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_drive_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_drive_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_drive_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_finger_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_base" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_drive_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_drive_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_drive_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_drive_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_finger_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_center_slider" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_drive_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_drive_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_drive_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_finger_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_x" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_y" link2="gripper_drive_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_y" link2="gripper_drive_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_y" link2="gripper_finger_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_y" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_y" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_neg_y" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_x" link2="gripper_drive_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_x" link2="gripper_finger_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_x" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_x" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_x" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_y" link2="gripper_finger_neg_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_y" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_y" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_drive_pos_y" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_finger_neg_x" link2="gripper_finger_neg_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_finger_neg_x" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_finger_neg_x" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_finger_neg_y" link2="gripper_finger_pos_x" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_finger_neg_y" link2="gripper_finger_pos_y" reason="GripperMechanism"/>
  <disable_collisions link1="gripper_finger_pos_x" link2="gripper_finger_pos_y" reason="GripperMechanism"/>

  <!-- Wrist camera adjacent pairs (mounted on arm_link_5) -->

  <!-- NOTE: No disable_collisions between fingers and external objects.
       MoveIt will detect finger↔fruit and finger↔table/bin collisions
       for proper grasp planning. -->

</robot>
